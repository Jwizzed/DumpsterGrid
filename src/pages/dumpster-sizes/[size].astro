---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { DatabaseSync } from 'node:sqlite';
import { join } from 'node:path';

// Define static paths for standard dumpster sizes. Dimensions, weight
// (tonnage) allowance, and typical use case are generic, non-city-specific
// industry conventions for roll-off container sizes — not derived from this
// site's per-city database and not claimed as a specific hauler's numbers.
// Pricing is NOT hardcoded here (previously: fabricated flat numbers with no
// source) — it is read from dumpsters.db below and labeled with the same
// price_basis Lane A stamped on every location row.
export function getStaticPaths() {
  return [
    {
      params: { size: '10-yard' },
      props: {
        sizeName: '10-Yard',
        tons: 2,
        dimensions: "12' Long x 8' Wide x 3.5' High",
        capacity: 'Suited to smaller loads of mixed debris.',
        ideal: 'Small kitchen or bathroom remodeling, yard debris removal, basement/garage cleanup, and light roofing updates.',
        column: '10yd'
      }
    },
    {
      params: { size: '20-yard' },
      props: {
        sizeName: '20-Yard',
        tons: 3,
        dimensions: "22' Long x 8' Wide x 4.5' High",
        capacity: 'A common middle-ground size for single-room to whole-house projects.',
        ideal: 'Whole-house cleanouts, carpet or flooring removals, deck demolitions, and medium-scale construction projects.',
        column: '20yd'
      }
    },
    {
      params: { size: '30-yard' },
      props: {
        sizeName: '30-Yard',
        tons: 4,
        dimensions: "22' Long x 8' Wide x 6' High",
        capacity: 'Built for high-volume residential and light commercial jobs.',
        ideal: 'Major residential additions, complete siding replacements, commercial waste operations, and large roofing demolitions.',
        column: '30yd'
      }
    },
    {
      params: { size: '40-yard' },
      props: {
        sizeName: '40-Yard',
        tons: 5,
        dimensions: "22' Long x 8' Wide x 8' High",
        capacity: 'The largest standard roll-off size, for full demolition and industrial-scale debris.',
        ideal: 'Large-scale commercial demolition sites, building roof replacements, industrial waste cleanup, and major construction builds.',
        column: '40yd'
      }
    }
  ];
}

const { sizeName, tons, dimensions, capacity, ideal, column } = Astro.props;

const dbPath = join(process.cwd(), 'dumpsters.db');
const db = new DatabaseSync(dbPath);

// National price range for this size, derived from the actual per-city
// figures on file (avg across all 10,000 rows) rather than an invented flat
// number. Every row shares the same price_basis string, so read it once.
const priceRow = db
  .prepare(
    `SELECT
       MIN(avg_low_${column}) AS lowMin,
       MAX(avg_high_${column}) AS highMax,
       ROUND(AVG(avg_low_${column})) AS lowAvg,
       ROUND(AVG(avg_high_${column})) AS highAvg,
       (SELECT price_basis FROM locations LIMIT 1) AS priceBasis
     FROM locations`
  )
  .get() as {
  lowMin: number;
  highMax: number;
  lowAvg: number;
  highAvg: number;
  priceBasis: string;
};

// Only the ~166 "verified" cities — the ones with a confirmed local
// landfill on file, and the only per-city pages in the sitemap. Linking a
// size page into the estimated set would send a "genuinely indexable"
// page's link equity to a noindex page for no reason.
const verifiedCitiesStmt = db.prepare(`
  SELECT city, state, slug
  FROM locations
  WHERE data_quality = 'verified'
  ORDER BY population DESC
  LIMIT 12
`);
const verifiedCities = verifiedCitiesStmt.all() as Array<{ city: string; state: string; slug: string }>;

// Product schema uses the real derived range (AggregateOffer), not a single
// fabricated "price" claim implying an exact, transactable figure.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${sizeName} Roll-Off Dumpster`,
  description: `Physical specifications for the standard ${sizeName} roll-off waste container. Physical size: ${dimensions}. Weight allowance: ${tons} tons included before overage fees apply.`,
  image: 'https://dumpstergrid.com/favicon.svg',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: priceRow.lowMin,
    highPrice: priceRow.highMax,
    offerCount: '1'
  }
};
const schemaString = JSON.stringify(schema);
---

<Layout
  title={`${sizeName} Roll-Off Dumpster Specifications & Dimensions | DumpsterGrid`}
  description={`Learn everything about renting a ${sizeName} roll-off dumpster. Compare full dimensions: ${dimensions}, weight capacity: ${tons} tons, and a national price estimate.`}
  schema={schemaString}
>
  <!-- Sizing Banner Header -->
  <section class="relative py-20 px-6 overflow-hidden bg-gradient-to-b from-slate-50/50 via-white to-white border-b border-slate-100">
    <div class="ambient-glow-amber w-[400px] h-[400px] -top-10 -right-10 animate-pulse-slow"></div>
    <div class="ambient-glow-blue w-[400px] h-[400px] bottom-10 left-10 animate-pulse-slow"></div>

    <div class="max-w-4xl mx-auto text-center space-y-4 relative z-10">
      <div class="inline-block px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/25 text-brand-600 font-display font-bold text-xs uppercase tracking-wider">
        📏 Bin Size Specifications
      </div>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl text-slate-900 leading-tight">
        The {sizeName} Roll-Off Dumpster
      </h1>
      <p class="text-slate-600 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Compare full physical dimensions, weight thresholds, and volume capacities to ensure you rent the right container.
      </p>
    </div>
  </section>

  <!-- Spec Grid & Lead Wizard -->
  <section class="pb-24 px-6 max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">

      <!-- Specifications Column -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">

        <!-- Physical Specs Card -->
        <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
          <h3 class="font-display font-extrabold text-2xl text-slate-900 border-b border-slate-100 pb-4">
            Physical Dimensions & Capacity
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
              <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">📐 Physical Footprint</span>
              <span class="font-display font-extrabold text-slate-800 text-base">{dimensions}</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
              <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">🚛 Volume Capacity</span>
              <span class="font-display font-extrabold text-slate-800 text-base">{capacity}</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
              <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">⚖️ Typical Weight Allowance</span>
              <span class="font-display font-extrabold text-slate-800 text-base">{tons} Tons Included</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
              <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">💲 National Price Estimate</span>
              <span class="font-display font-extrabold text-brand-600 text-base">${priceRow.lowAvg}–${priceRow.highAvg}</span>
            </div>
          </div>

          <p class="text-xs text-slate-500 leading-relaxed pt-2 border-t border-slate-100">
            Price shown is a {priceRow.priceBasis} across all service areas on file (range: ${priceRow.lowMin}–${priceRow.highMax}) — not a quote for any specific city. Actual cost depends on local haulers, landfill tipping fees, and permit requirements; see a city page below for that area's figures.
          </p>
        </div>

        <!-- Best For / Ideal Cases -->
        <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-4">
          <h3 class="font-display font-extrabold text-xl text-slate-900">
            What projects is a {sizeName} dumpster best for?
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            This size is generally recommended for:
          </p>
          <div class="p-4 rounded-xl bg-brand-50/50 border border-brand-500/20 text-sm text-slate-700 leading-relaxed shadow-sm">
            💡 <strong>Best Use Cases:</strong> {ideal}
          </div>
        </div>

      </div>

      <!-- Form Column -->
      <div class="lg:col-span-5 w-full">
        <LeadForm />
      </div>

    </div>
  </section>

  <!-- Verified Cities Directory -->
  <section class="py-20 px-6 bg-slate-50 border-t border-slate-200">
    <div class="max-w-5xl mx-auto space-y-12">
      <div class="text-center space-y-3">
        <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-slate-900">
          Book a {sizeName} Container in Verified Cities
        </h2>
        <p class="text-slate-600 text-sm">These cities have confirmed local landfill and permit data on file.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {verifiedCities.map(city => (
          <a
            href={`/locations/${city.slug}`}
            class="px-4 py-3.5 rounded-xl bg-white border border-slate-200 hover:border-brand-500/50 hover:bg-brand-50/10 text-xs font-semibold text-slate-600 hover:text-brand-600 transition-all text-center flex items-center justify-between shadow-sm"
          >
            <span class="flex items-center gap-1.5">
              <span class="text-brand-600">✓</span> {city.city}, {city.state}
            </span>
            <span class="text-brand-600 font-bold">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
