---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { DatabaseSync } from 'node:sqlite';
import { join } from 'node:path';

// Fetch all locations to populate the autocomplete datalist
const dbPath = join(process.cwd(), 'dumpsters.db');
const db = new DatabaseSync(dbPath);
const stmt = db.prepare(`
  SELECT city, state, state_full, population, slug 
  FROM locations 
  ORDER BY population DESC
`);
const locations = stmt.all() as Array<{ city: string; state: string; state_full: string; population: number; slug: string }>;

// Isolate top cities to render high-impact quick link tags
const topLocations = locations.slice(0, 8);
---

<Layout 
  title="Affordable Roll-Off Dumpster Rentals Nationwide | DumpsterFlow" 
  description="Rent a roll-off dumpster for construction, residential cleanouts, or roofing. Get dynamic local rates, flat-rate pricing, and instant dispatch near you."
>
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center justify-center py-16 px-6 overflow-hidden">
    
    <!-- Ambient Glows -->
    <div class="ambient-glow-amber w-[450px] h-[450px] -top-20 -left-20 animate-pulse-slow"></div>
    <div class="ambient-glow-blue w-[500px] h-[500px] -bottom-20 -right-20 animate-pulse-slow"></div>
    
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10 w-full">
      
      <!-- Hero Copy -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-500 font-display font-bold text-xs tracking-wider uppercase">
          ⚡ Flat-Rate Dumpster Rentals Near You
        </div>
        
        <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight text-white leading-[1.1]">
          Unglarmorous Waste.<br />
          <span class="bg-gradient-to-r from-brand-500 to-amber-500 bg-clip-text text-transparent text-glow-amber">
            Ultra-Simple Pricing.
          </span>
        </h1>
        
        <p class="text-gray-400 text-base sm:text-lg max-w-xl mx-auto lg:mx-0 leading-relaxed">
          No hidden fuel fees, no surprise drop-off surcharges. We connect you with the lowest-priced local haulers in 150+ U.S. cities instantly.
        </p>

        <!-- Dynamic City Autocomplete Search Bar -->
        <div class="w-full max-w-lg mx-auto lg:mx-0">
          <div class="relative group">
            <div class="absolute inset-0 bg-brand-500 rounded-2xl blur-md opacity-25 group-focus-within:opacity-40 transition-opacity"></div>
            <div class="relative flex items-center bg-dark-surface/90 border border-dark-border rounded-2xl p-2.5 shadow-2xl">
              <span class="text-xl pl-3 select-none">📍</span>
              <input 
                type="text" 
                id="search-city-input"
                list="location-datalist" 
                placeholder="Enter your city (e.g. Austin, TX)..." 
                class="w-full bg-transparent border-none text-white pl-3 pr-4 py-2 font-display font-semibold focus:outline-none placeholder:text-gray-600 text-sm sm:text-base"
              />
              <datalist id="location-datalist">
                {locations.map(loc => (
                  <option value={`${loc.city}, ${loc.state}`}>{loc.city}, {loc.state_full}</option>
                ))}
              </datalist>
              <button 
                type="button"
                id="btn-search-city"
                class="px-5 py-3 rounded-xl bg-brand-500 text-dark-bg font-display font-bold text-sm uppercase tracking-wider hover:bg-brand-600 active:scale-95 transition-all shadow-[0_4px_12px_rgba(245,158,11,0.2)] cursor-pointer"
              >
                Go
              </button>
            </div>
          </div>
          <p id="search-error" class="hidden text-xs text-red-500 mt-2 font-semibold text-center lg:text-left">
            ⚠️ City not found in directory. Please pick a location from the suggestions list.
          </p>
        </div>

        <!-- Hot Locations -->
        <div class="pt-4 space-y-3">
          <span class="block text-xs font-semibold uppercase tracking-wider text-gray-500">Popular Markets:</span>
          <div class="flex flex-wrap gap-2 justify-center lg:justify-start">
            {topLocations.map(loc => (
              <a 
                href={`/locations/${loc.slug}`}
                class="px-3 py-1.5 rounded-lg bg-dark-card/50 border border-dark-border hover:border-brand-500/40 text-xs text-gray-300 hover:text-white transition-all hover:-translate-y-0.5"
              >
                {loc.city}, {loc.state}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Form Section -->
      <div class="lg:col-span-5 w-full">
        <LeadForm />
      </div>

    </div>
  </section>

  <!-- Size Chart Section -->
  <section class="py-24 px-6 bg-dark-surface/30 border-y border-dark-border relative">
    <div class="max-w-7xl mx-auto space-y-16">
      
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <div class="inline-block px-3.5 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-500 font-display font-bold text-xs uppercase tracking-widest">
          Sizing Chart
        </div>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white leading-tight">
          Select the Right Bin for Your Job
        </h2>
        <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
          Choosing the wrong size can lead to overage fees or double-hauling bills. Compare dimensions and best use cases below.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- 10YD Card -->
        <div class="glass-card-interactive rounded-2xl p-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-display font-extrabold text-2xl text-white">10-Yard</span>
              <span class="text-xs font-semibold px-2 py-1 rounded bg-brand-500/10 text-brand-500">Small</span>
            </div>
            <p class="text-xs text-gray-400 leading-relaxed">
              Fits ~4 pickup truck beds. Ideal for basement cleanouts, yard waste cleanup, or minor bathroom remodeling.
            </p>
            <div class="border-t border-gray-800 pt-4 space-y-1.5 text-xs text-gray-400">
              <div>📐 **Dimensions:** 12' L x 8' W x 3.5' H</div>
              <div>⚖️ **Included Tonnage:** 2 Tons</div>
            </div>
          </div>
          <a href="/dumpster-sizes/10-yard" class="block w-full text-center mt-6 py-2.5 rounded-xl bg-dark-bg border border-dark-border hover:border-brand-500/30 hover:bg-dark-surface text-xs font-bold text-gray-300 hover:text-white transition-all">
            View 10yd Specs
          </a>
        </div>

        <!-- 20YD Card -->
        <div class="glass-card-interactive rounded-2xl p-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-display font-extrabold text-2xl text-white">20-Yard</span>
              <span class="text-xs font-semibold px-2 py-1 rounded bg-brand-500/10 text-brand-500">Medium</span>
            </div>
            <p class="text-xs text-gray-400 leading-relaxed">
              Fits ~8 pickup truck beds. The most popular choice for whole-house cleanouts, roof shingle replacement, and carpet updates.
            </p>
            <div class="border-t border-gray-800 pt-4 space-y-1.5 text-xs text-gray-400">
              <div>📐 **Dimensions:** 22' L x 8' W x 4.5' H</div>
              <div>⚖️ **Included Tonnage:** 3 Tons</div>
            </div>
          </div>
          <a href="/dumpster-sizes/20-yard" class="block w-full text-center mt-6 py-2.5 rounded-xl bg-dark-bg border border-dark-border hover:border-brand-500/30 hover:bg-dark-surface text-xs font-bold text-gray-300 hover:text-white transition-all">
            View 20yd Specs
          </a>
        </div>

        <!-- 30YD Card -->
        <div class="glass-card-interactive rounded-2xl p-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-display font-extrabold text-2xl text-white">30-Yard</span>
              <span class="text-xs font-semibold px-2 py-1 rounded bg-brand-500/10 text-brand-500">Large</span>
            </div>
            <p class="text-xs text-gray-400 leading-relaxed">
              Fits ~12 pickup truck beds. Designed for major renovations, home additions, commercial waste, and large-scale siding.
            </p>
            <div class="border-t border-gray-800 pt-4 space-y-1.5 text-xs text-gray-400">
              <div>📐 **Dimensions:** 22' L x 8' W x 6' H</div>
              <div>⚖️ **Included Tonnage:** 4 Tons</div>
            </div>
          </div>
          <a href="/dumpster-sizes/30-yard" class="block w-full text-center mt-6 py-2.5 rounded-xl bg-dark-bg border border-dark-border hover:border-brand-500/30 hover:bg-dark-surface text-xs font-bold text-gray-300 hover:text-white transition-all">
            View 30yd Specs
          </a>
        </div>

        <!-- 40YD Card -->
        <div class="glass-card-interactive rounded-2xl p-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-display font-extrabold text-2xl text-white">40-Yard</span>
              <span class="text-xs font-semibold px-2 py-1 rounded bg-brand-500/10 text-brand-500">X-Large</span>
            </div>
            <p class="text-xs text-gray-400 leading-relaxed">
              Fits ~16 pickup truck beds. Recommended for commercial demolition sites, building cleanouts, and major industrial trash needs.
            </p>
            <div class="border-t border-gray-800 pt-4 space-y-1.5 text-xs text-gray-400">
              <div>📐 **Dimensions:** 22' L x 8' W x 8' H</div>
              <div>⚖️ **Included Tonnage:** 5 Tons</div>
            </div>
          </div>
          <a href="/dumpster-sizes/40-yard" class="block w-full text-center mt-6 py-2.5 rounded-xl bg-dark-bg border border-dark-border hover:border-brand-500/30 hover:bg-dark-surface text-xs font-bold text-gray-300 hover:text-white transition-all">
            View 40yd Specs
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- Features Block -->
  <section class="py-24 px-6 max-w-7xl mx-auto space-y-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <div class="space-y-6">
        <div class="inline-block px-3.5 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-500 font-display font-bold text-xs uppercase tracking-widest">
          Why Choose Us
        </div>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white leading-tight">
          Simplifying Waste Solutions for Contractors & Homeowners
        </h2>
        <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
          Traditional haulers have complex billing systems, hidden surcharges, and limited customer service departments. We bridge that gap by aggregating local dispatch systems into an integrated platform.
        </p>

        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-4">
            <div class="bg-brand-500/10 text-brand-500 p-2 rounded-lg mt-0.5 text-xs font-bold">✓</div>
            <div>
              <h4 class="font-display font-bold text-white text-sm">Flat-Rate local prices</h4>
              <p class="text-xs text-gray-400 mt-1">Our rates always bundle delivery, pickup, rental days, and landfill tipping weight allowances.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="bg-brand-500/10 text-brand-500 p-2 rounded-lg mt-0.5 text-xs font-bold">✓</div>
            <div>
              <h4 class="font-display font-bold text-white text-sm">Fast localized dispatch</h4>
              <p class="text-xs text-gray-400 mt-1">We route requests to local dispatchers in your county, securing next-day drops in 90% of cases.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="bg-brand-500/10 text-brand-500 p-2 rounded-lg mt-0.5 text-xs font-bold">✓</div>
            <div>
              <h4 class="font-display font-bold text-white text-sm">Full permitting guides</h4>
              <p class="text-xs text-gray-400 mt-1">We analyze city and county Right-of-Way codes, taking care of the paperwork if your dumpster has to sit on public streets.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Call to Action Banner -->
      <div class="glass-card rounded-3xl p-8 sm:p-12 text-center space-y-6 border-brand-500/20 shadow-2xl relative overflow-hidden">
        <div class="absolute inset-0 bg-radial-gradient from-brand-500/5 to-transparent pointer-events-none"></div>
        <span class="text-4xl">📞</span>
        <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-white">
          Need a dumpster immediately?
        </h3>
        <p class="text-sm text-gray-300 max-w-sm mx-auto leading-relaxed">
          Skip the forms. Call our emergency national dispatcher to get instantly matched with a verified hauler in your zip code.
        </p>
        <div class="pt-2">
          <a href="tel:800-508-4000" class="inline-flex items-center gap-3 px-6 py-4 bg-brand-500 text-dark-bg font-display font-extrabold text-base uppercase tracking-wider rounded-xl transition-all hover:bg-brand-600 active:scale-95 shadow-[0_4px_25px_rgba(245,158,11,0.25)]">
            Call 1-800-508-4000
          </a>
        </div>
        <span class="block text-[10px] text-gray-500">Live dispatch operating Mon-Sat 7:00 AM - 7:00 PM EST</span>
      </div>

    </div>
  </section>

  <!-- Client side autocomplete redirect listener -->
  <script>
    function initializeSearch() {
      const searchInput = document.getElementById('search-city-input') as HTMLInputElement;
      const searchBtn = document.getElementById('btn-search-city');
      const searchError = document.getElementById('search-error');
      const datalist = document.getElementById('location-datalist');
      
      if (!searchInput || !searchBtn) return;
      
      // Get all options in the datalist
      const options = Array.from(datalist?.querySelectorAll('option') || []).map(opt => opt.value.toLowerCase());

      function handleSearch() {
        const value = searchInput.value.trim().toLowerCase();
        if (!value) return;

        // Verify if it exists in the list
        if (!options.includes(value)) {
          searchError?.classList.remove('hidden');
          return;
        }
        searchError?.classList.add('hidden');

        // Extract city & state from pattern "City, ST"
        const parts = value.split(',');
        const cityPart = parts[0].trim().replace(/\s+/g, '-');
        const statePart = parts[1].trim();

        // Redirect
        window.location.href = `/locations/dumpster-rental-${cityPart}-${statePart}`;
      }

      searchBtn.addEventListener('click', handleSearch);
      searchInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          handleSearch();
        }
      });
      searchInput.addEventListener('input', () => {
        searchError?.classList.add('hidden');
      });
    }

    initializeSearch();
    document.addEventListener('astro:page-load', initializeSearch);
  </script>

</Layout>
