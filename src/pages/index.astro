  <!-- Client side autocomplete redirect listener -->
  <script>
    function initializeSearch() {
      const searchInput = document.getElementById('search-city-input') as HTMLInputElement;
      const searchBtn = document.getElementById('btn-search-city');
      const searchError = document.getElementById('search-error');
      const datalist = document.getElementById('location-datalist');
      
      if (!searchInput || !searchBtn) return;
      
      // Get all options in the datalist
      const options = Array.from(datalist?.querySelectorAll('option') || []).map(opt => opt.value.toLowerCase());

      function handleSearch() {
        const value = searchInput.value.trim().toLowerCase();
        if (!value) return;

        // Verify if it exists in the list
        if (!options.includes(value)) {
          searchError?.classList.remove('hidden');
          return;
        }
        searchError?.classList.add('hidden');

        // Extract city & state from pattern "City, ST"
        const parts = value.split(',');
        const cityPart = parts[0].trim().replace(/\s+/g, '-');
        const statePart = parts[1].trim();

        // Redirect
        window.location.href = `/locations/dumpster-rental-${cityPart}-${statePart}`;
      }

      searchBtn.addEventListener('click', handleSearch);
      searchInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          handleSearch();
        }
      });
      searchInput.addEventListener('input', () => {
        searchError?.classList.add('hidden');
      });
    }

    initializeSearch();
    document.addEventListener('astro:page-load', initializeSearch);
  </script>

