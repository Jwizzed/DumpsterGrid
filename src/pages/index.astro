---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { DatabaseSync } from 'node:sqlite';
import { join } from 'node:path';

// Fetch top 1,000 locations to populate the autocomplete datalist (optimizes HTML payload and memory)
const dbPath = join(process.cwd(), 'dumpsters.db');
const db = new DatabaseSync(dbPath);
const stmt = db.prepare(`
  SELECT city, state, state_full, population, slug 
  FROM locations 
  ORDER BY population DESC
  LIMIT 1000
`);
const locations = stmt.all() as Array<{ city: string; state: string; state_full: string; population: number; slug: string }>;

// Isolate top cities to render high-impact quick link tags
const topLocations = locations.slice(0, 8);
---

<Layout 
  title="Affordable Roll-Off Dumpster Rentals Nationwide | DumpsterGrid" 
  description="Rent a roll-off dumpster for construction, residential cleanouts, or roofing. Get dynamic local rates, flat-rate pricing, and instant dispatch near you."
>
  <!-- Hero Section (Visual Background Mode Modeled After BD) -->
  <section class="relative min-h-[calc(100vh-73px)] flex items-center py-12 px-6 md:px-12 overflow-hidden bg-cover bg-center" style="background-image: url('/images/dumpster_hero.png');">
    
