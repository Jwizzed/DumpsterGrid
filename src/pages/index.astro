    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-900/75 to-transparent pointer-events-none z-0"></div>
    
    <div class="max-w-7xl mx-auto relative z-10 w-full text-left">
      
      <!-- Hero Copy Left Container -->
      <div class="max-w-2xl space-y-7 text-left">
        
        <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-[3.85rem] tracking-tight text-white leading-[1.08] drop-shadow-md text-left max-w-2xl">
          Affordable dumpster rentals.<br />
          Service you can depend on.
        </h1>
        
        <p class="text-slate-200 text-base sm:text-lg max-w-xl leading-relaxed drop-shadow-xs">
          No hidden fuel fees, no surprise drop-off surcharges. We connect you with the lowest-priced local haulers in 150+ U.S. cities instantly.
        </p>
 
        <!-- Orange Interactive Trigger Button -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-start gap-4">
          <button 
            type="button"
            onclick="const el = document.getElementById('zip-code') || document.getElementById('quote-section'); if(el) { el.scrollIntoView({behavior: 'smooth'}); setTimeout(() => el.focus(), 600); }"
            class="w-full sm:w-auto px-9 py-4.5 bg-[#f07c00] hover:bg-[#d97000] text-white font-display font-extrabold text-base uppercase tracking-wider rounded-xl transition-all shadow-lg active:scale-95 cursor-pointer shadow-orange-500/25"
          >
            Check Your Price
          </button>
        </div>
 
        <!-- Hot Locations -->
        <div class="pt-4 space-y-3">
          <span class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Popular Markets:</span>
          <div class="flex flex-wrap gap-2 justify-start">
            {topLocations.map(loc => (
              <a 
                href={`/locations/${loc.slug}`}
                class="px-3 py-1.5 rounded-lg bg-white/10 backdrop-blur-xs border border-white/15 hover:border-brand-500/50 hover:bg-white/20 text-xs text-slate-200 hover:text-white transition-all shadow-sm"
