---
import Layout from '../../../layouts/Layout.astro';
import { DatabaseSync } from 'node:sqlite';
import { join } from 'node:path';

// Define static paths for all unique states in the database
export function getStaticPaths() {
  const dbPath = join(process.cwd(), 'dumpsters.db');
  const db = new DatabaseSync(dbPath);
  const stmt = db.prepare('SELECT DISTINCT state, state_full FROM locations');
  const states = stmt.all() as Array<{ state: string; state_full: string }>;
  
  return states.map(s => ({
    params: { state: s.state.toLowerCase() },
    props: { stateCode: s.state, stateFull: s.state_full }
  }));
}

const { stateCode, stateFull } = Astro.props;

// Fetch all cities belonging to this state
const dbPath = join(process.cwd(), 'dumpsters.db');
const db = new DatabaseSync(dbPath);
const stmt = db.prepare('SELECT city, population, slug FROM locations WHERE state = ? ORDER BY city ASC');
const cities = stmt.all(stateCode) as Array<{ city: string; population: number; slug: string }>;
---

<Layout 
  title={`Roll-Off Dumpster Rentals in ${stateFull} | DumpsterFlow`} 
  description={`Find cheap roll-off dumpster rentals in ${stateFull}. Compare local dumpster cost plans, sizes, and Right-of-Way permitting rules in your city.`}
>
  <!-- Header -->
  <section class="relative py-20 px-6 overflow-hidden">
    <div class="ambient-glow-amber w-[400px] h-[400px] -top-10 -right-10 animate-pulse-slow"></div>
    <div class="ambient-glow-blue w-[400px] h-[400px] bottom-10 left-10 animate-pulse-slow"></div>
    
    <div class="max-w-4xl mx-auto text-center space-y-4 relative z-10">
      <div class="inline-block px-3.5 py-1 rounded-full bg-brand-500/10 border border-brand-500/25 text-brand-500 font-display font-bold text-xs uppercase tracking-wider">
        📍 {stateCode} State Directory
      </div>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl text-white leading-tight">
        Dumpster Services in {stateFull}
      </h1>
      <p class="text-gray-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Select a city in {stateFull} below to compare local sizes, pricing charts, and secure local waste dispatch permits.
      </p>
    </div>
  </section>

  <!-- Cities Grid -->
  <section class="pb-24 px-6 max-w-5xl mx-auto relative z-10">
    <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
      <div class="flex items-center justify-between border-b border-gray-800 pb-4">
        <h2 class="font-display font-extrabold text-xl text-white">
          Active Service Cities in {stateFull}
        </h2>
        <span class="text-xs font-semibold px-2 py-0.5 rounded bg-dark-bg text-gray-500">
          {cities.length} Cities
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {cities.map(city => (
          <a 
            href={`/locations/${city.slug}`}
            class="px-4 py-3.5 rounded-xl bg-dark-bg/60 border border-dark-border hover:border-brand-500/30 hover:bg-dark-surface text-xs font-semibold text-gray-300 hover:text-white transition-all text-center sm:text-left flex items-center justify-between"
          >
            <span>{city.city}</span>
            <span class="text-[10px] text-brand-500 font-display font-bold">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
