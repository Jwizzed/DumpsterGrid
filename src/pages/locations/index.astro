---
import Layout from '../../layouts/Layout.astro';
import { DatabaseSync } from 'node:sqlite';
import { join } from 'node:path';

// Fetch states with their programmatic city counts from SQLite vault
const dbPath = join(process.cwd(), 'dumpsters.db');
const db = new DatabaseSync(dbPath);

const statesStmt = db.prepare(`
  SELECT state, state_full, COUNT(*) AS city_count 
  FROM locations 
  GROUP BY state, state_full 
  ORDER BY state_full ASC
`);
const states = statesStmt.all() as Array<{ state: string; state_full: string; city_count: number }>;
---

<Layout 
  title="Local Roll-Off Dumpster Service Directory | DumpsterGrid" 
  description="Explore our complete state-by-state directory of locations for roll-off dumpster rentals. Find localized dumpster cost plans, sizes, and permits."
>
  <!-- Directory Header -->
  <section class="relative py-20 px-6 overflow-hidden">
    <div class="ambient-glow-amber w-[400px] h-[400px] -top-10 -right-10 animate-pulse-slow"></div>
    <div class="ambient-glow-blue w-[400px] h-[400px] bottom-10 left-10 animate-pulse-slow"></div>
    
    <div class="max-w-4xl mx-auto text-center space-y-4 relative z-10">
      <div class="inline-block px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/25 text-brand-500 font-display font-bold text-xs uppercase tracking-wider">
        🌍 National Directory
      </div>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl text-white leading-tight">
        Local Dumpster Service Areas
      </h1>
      <p class="text-gray-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Select your state below to find affordable local roll-off bin haulers, permit requirements, and pricing schedules in your city.
      </p>
    </div>
  </section>

  <!-- States Aggregated Grid -->
  <section class="pb-24 px-6 max-w-5xl mx-auto relative z-10">
    <div class="glass-card rounded-3xl p-8 space-y-8">
      <div class="border-b border-gray-800 pb-4 flex items-center justify-between">
        <h2 class="font-display font-extrabold text-xl sm:text-2xl text-white flex items-center gap-3">
          <span class="text-brand-500 font-normal select-none">🗺️</span>
          United States Directory
        </h2>
        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-dark-bg border border-dark-border text-gray-400">
          {states.length} Active Regions
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {states.map(state => (
          <a 
            href={`/locations/${state.state.toLowerCase()}`}
            class="px-5 py-4 rounded-2xl bg-dark-bg/60 border border-dark-border hover:border-brand-500/30 hover:bg-dark-surface text-sm font-semibold text-gray-300 hover:text-white transition-all flex items-center justify-between group"
          >
            <div class="flex items-center gap-3">
              <span class="text-xs font-bold text-brand-500 select-none">📌</span>
              <span>{state.state_full}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] text-gray-500 font-display bg-dark-card border border-dark-border px-2 py-0.5 rounded-lg group-hover:border-brand-500/20 group-hover:text-brand-500 transition-colors">
                {state.city_count} Cities
              </span>
              <span class="text-brand-500 font-bold opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
