---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { DatabaseSync } from 'node:sqlite';
import { join } from 'node:path';

// Define static paths for all 10,000 programmatic city routes
export function getStaticPaths() {
  const dbPath = join(process.cwd(), 'dumpsters.db');
  const db = new DatabaseSync(dbPath);
  const stmt = db.prepare('SELECT slug FROM locations');
  const locations = stmt.all() as Array<{ slug: string }>;

  return locations.map(loc => ({
    params: { slug: loc.slug }
  }));
}

const { slug } = Astro.params;

// Fetch full city records including low/high price ranges from SQLite
const dbPath = join(process.cwd(), 'dumpsters.db');
const db = new DatabaseSync(dbPath);
const stmt = db.prepare('SELECT * FROM locations WHERE slug = ?');
const loc = stmt.get(slug) as {
  city: string;
  state: string;
  state_full: string;
  population: number;
  // NULL for all 9,834 'estimated' rows — only the 166 'verified' rows carry these.
  permit_required: number | null;
  permit_cost: number | null;
  landfill_name: string | null;
  data_quality: string;
  price_basis: string;
  avg_low_10yd: number;
  avg_high_10yd: number;
  avg_low_20yd: number;
  avg_high_20yd: number;
  avg_low_30yd: number;
  avg_high_30yd: number;
  avg_low_40yd: number;
  avg_high_40yd: number;
};

const cityName = loc.city;
const stateCode = loc.state;
const stateFull = loc.state_full;

// Flip to `true` to restore the previous 10,060-page indexable set (i.e. let
// Google index all 'estimated' cities again, not just the 166 verified ones).
const INDEX_ESTIMATED_PAGES = false;

const isVerified = loc.data_quality === 'verified';
const hasLandfill = isVerified && !!loc.landfill_name;
const hasPermitInfo = isVerified && loc.permit_required !== null && loc.permit_cost !== null;
const noindex = loc.data_quality === 'estimated' && !INDEX_ESTIMATED_PAGES;

// Map price range items for loop rendering
const pricingPlans = [
  { size: '10-Yard', low: loc.avg_low_10yd, high: loc.avg_high_10yd, tons: 2.0, overage: 65, desc: 'Ideal for small room cleanouts, minor yard updates, or bathroom remodeling.' },
  { size: '20-Yard', low: loc.avg_low_20yd, high: loc.avg_high_20yd, tons: 3.0, overage: 70, desc: 'Great for whole-house cleanouts, roof shingle replacement, and carpet removal.' },
  { size: '30-Yard', low: loc.avg_low_30yd, high: loc.avg_high_30yd, tons: 4.0, overage: 75, desc: 'Designed for home additions, major renovations, or commercial waste needs.' },
  { size: '40-Yard', low: loc.avg_low_40yd, high: loc.avg_high_40yd, tons: 5.0, overage: 80, desc: 'Recommended for large-scale demolition sites or major construction builds.' }
];

const popular20ydLow = loc.avg_low_20yd;

// ----------------------------------------------------------------------
// Real-fact-driven copy. No spinning: same inputs always produce the same
// sentence, and where there's no real fact for this row, we write nothing
// rather than filling the gap with generic prose.
// ----------------------------------------------------------------------
function populationBand(pop: number): string {
  if (pop >= 500000) return 'a major metro area';
  if (pop >= 100000) return 'a large city';
  if (pop >= 25000) return 'a mid-size city';
  return 'a small city';
}

let heroIntro = `DumpsterGrid helps you compare roll-off dumpster sizes and typical costs for ${cityName}, ${stateFull} — ${populationBand(loc.population)} with a population of about ${loc.population.toLocaleString()}.`;
if (hasLandfill) {
  heroIntro += ` Waste collected here is typically hauled to ${loc.landfill_name}.`;
}

const priceBasisLabel = loc.price_basis.charAt(0).toUpperCase() + loc.price_basis.slice(1);
const pricingIntro = `${priceBasisLabel}. These are typical U.S. ranges, not a quote for ${cityName} — get your exact price through the form below.`;

const permitParagraph = hasPermitInfo
  ? (loc.permit_required === 1
      ? `${cityName} requires a street placement permit if your container sits on a public street, sidewalk, or alley. The typical fee on file is $${(loc.permit_cost as number).toFixed(2)}. Placing the container entirely on private property (driveway, yard, lot) usually avoids this requirement.`
      : `${cityName} does not require a standard street placement permit for typical residential drop-offs, on file as of our last check. Keep the container clear of hydrants, sidewalks, and traffic lanes regardless.`)
  : '';

const landfillParagraph = hasLandfill
  ? `Waste collected in ${cityName} is typically hauled to ${loc.landfill_name}.`
  : '';

// FAQ content — kept only because it's real, generic, answerable information
// (not a city-specific claim), so FAQPage schema below is honest.
const faqEntries = [
  {
    q: `What is the typical rental period for a dumpster in ${cityName}?`,
    a: `Our standard flat-rate packages include a 10-day rental period. If you finish early, let us know through the quote form above and we'll schedule an earlier pickup. Extended rentals can be arranged for a nominal daily fee.`
  },
  {
    q: `What materials are restricted from entering the dumpster?`,
    a: `By standard environmental code, you cannot place hazardous waste, toxic chemicals, wet paint, batteries, flammable materials, raw medical waste, or propane tanks into the dumpster. Tires and refrigerators require special processing and must be cleared beforehand.`
  },
  {
    q: `How do I avoid overage fees?`,
    a: `Overage fees are assessed only if the weight of your debris exceeds the included tonnage allowance (e.g. 3 tons for a 20-Yard dumpster). To avoid fees, keep the dumpster covered during heavy rainstorms to prevent water weight, and don't fill it past the "Maximum Load" indicator line.`
  }
];

// Construct dynamic JSON-LD Schema. We are a referral network, not a
// LocalBusiness operating in 10,000 cities — Service + BreadcrumbList only,
// plus FAQPage since those Q&As are real and answerable. No Offer/
// AggregateOffer: our prices are a national estimate, never a local quote.
const schemaGraph: Record<string, unknown>[] = [
  {
    "@type": "Service",
    "serviceType": "Dumpster Rental",
    "name": `Dumpster Rental Referrals in ${cityName}, ${stateCode}`,
    "description": `DumpsterGrid connects residential and commercial customers in ${cityName}, ${stateCode} with independent roll-off dumpster rental haulers. DumpsterGrid is a referral and informational resource network — it does not own or operate dumpsters directly.`,
    "areaServed": {
      "@type": "City",
      "name": cityName,
      "containedInPlace": {
        "@type": "State",
        "name": stateFull
      }
    },
    "provider": {
      "@type": "Organization",
      "name": "DumpsterGrid",
      "url": "https://dumpstergrid.com/"
    }
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://dumpstergrid.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Locations",
        "item": "https://dumpstergrid.com/locations"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": stateFull,
        "item": `https://dumpstergrid.com/locations/${stateCode.toLowerCase()}`
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": cityName,
        "item": `https://dumpstergrid.com/locations/${slug}`
      }
    ]
  },
  {
    "@type": "FAQPage",
    "mainEntity": faqEntries.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  }
];
const schema = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};
const schemaString = JSON.stringify(schema);

const pageTitle = `Dumpster Rental in ${cityName}, ${stateCode} — Sizes, Permits & Cost Guide`;
const pageDescription = `Compare 10, 20, 30 and 40-yard roll-off dumpster sizes for ${cityName}, ${stateCode}. See typical U.S. price ranges (${loc.price_basis} — not a local quote) and get a free project quote online.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={schemaString}
  noindex={noindex}
>
  <!-- Hero Section (Visual Background Mode Modeled After BD) -->
  <section class="relative min-h-[calc(100vh-73px)] flex items-center py-12 px-6 md:px-12 overflow-hidden bg-cover bg-center" style="background-image: url('/images/dumpster_hero.png');">

    <!-- Dark Gradient Overlay for Maximum Text Contrast -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-900/75 to-transparent pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto relative z-10 w-full text-left">

      <!-- Hero Copy Left Container -->
      <div class="max-w-2xl space-y-7 text-left text-white">

        <!-- Breadcrumbs -->
        <nav class="flex items-center justify-start gap-2 text-xs font-semibold text-slate-300 uppercase tracking-wider select-none mb-2">
          <a href="/" class="hover:text-brand-200 transition-colors">Home</a>
          <span>/</span>
          <a href="/locations" class="hover:text-brand-200 transition-colors">Locations</a>
          <span>/</span>
          <a href={`/locations/${stateCode.toLowerCase()}`} class="hover:text-brand-200 transition-colors">{stateFull}</a>
          <span>/</span>
          <span class="text-white">{cityName}</span>
        </nav>


        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-500/20 border border-brand-500/40 text-brand-200 font-display font-bold text-xs uppercase tracking-wider">
          {isVerified ? `📍 Verified Local Data for ${cityName}, ${stateCode}` : `📍 Serving ${cityName}, ${stateCode}`}
        </div>

        <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight text-white leading-[1.1] drop-shadow-md text-left">
          Roll-Off Dumpster Rental in <span class="bg-gradient-to-r from-brand-400 to-brand-500 bg-clip-text text-transparent text-glow-amber">{cityName}, {stateCode}</span>
        </h1>

        <p class="text-slate-200 text-base sm:text-lg max-w-xl leading-relaxed drop-shadow-xs">
          {heroIntro}
        </p>

        <!-- Trust bullet tags in white -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-lg pt-2 text-left text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <span class="text-brand-400 font-bold">✓</span> Local {cityName} dispatch routing
          </div>
          {hasLandfill && (
            <div class="flex items-center gap-2">
              <span class="text-brand-400 font-bold">✓</span> Direct hauling to {loc.landfill_name}
            </div>
          )}
          <div class="flex items-center gap-2">
            <span class="text-brand-400 font-bold">✓</span> Flat-rate quote guarantees
          </div>
          <div class="flex items-center gap-2">
            <span class="text-brand-400 font-bold">✓</span> Next-day dumpster drops available
          </div>
        </div>

        <!-- Orange Interactive Trigger Button -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-start gap-4">
          <button
            type="button"
            onclick="const el = document.getElementById('zip-code') || document.getElementById('quote-section'); if(el) { el.scrollIntoView({behavior: 'smooth'}); setTimeout(() => el.focus(), 600); }"
            class="w-full sm:w-auto px-9 py-4 bg-[#f07c00] hover:bg-[#d97000] text-white font-display font-extrabold text-base uppercase tracking-wider rounded-xl transition-all shadow-lg active:scale-95 cursor-pointer shadow-orange-500/25"
          >
            Check Your Price
          </button>
        </div>

      </div>

    </div>
  </section>

  <!-- Interactive Lead Quote Section -->
  <section id="quote-section" class="min-h-[calc(100vh-73px)] flex flex-col justify-center py-12 px-6 bg-white relative z-10 border-b border-slate-200 scroll-mt-[73px]">
    <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Text Copy Left Side -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <div class="inline-block px-3 py-1 rounded bg-[#f07c00]/10 border border-[#f07c00]/25 text-[#f07c00] font-display font-bold text-xs uppercase tracking-wider">
          ⏱️ Get a Local Quote
        </div>

        <h2 class="font-display font-extrabold text-4xl sm:text-5xl text-slate-900 leading-tight max-w-xl">
          Check Next-Day Availability in {cityName}
        </h2>

        <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-xl">
          Enter your ZIP code to check dispatch inventory, pricing, and permitted street placement guidelines in <strong class="font-bold">{cityName}, {stateCode}</strong>.
        </p>

        <!-- Dynamic Trust Checklist to balance height -->
        <div class="space-y-4 pt-4 max-w-lg text-left">
          <div class="flex items-start gap-4">
            <div class="bg-orange-50 text-[#f07c00] p-2 rounded-lg mt-0.5 text-xs font-bold shadow-sm">✓</div>
            <div>
              <h4 class="font-display font-bold text-slate-900 text-sm sm:text-base">{cityName} Dispatch</h4>
              <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Dispatch scheduling coordinated with regional hauling networks.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="bg-orange-50 text-[#f07c00] p-2 rounded-lg mt-0.5 text-xs font-bold shadow-sm">✓</div>
            <div>
              <h4 class="font-display font-bold text-slate-900 text-sm sm:text-base">Environmentally Compliant</h4>
              <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                {hasLandfill
                  ? `All waste loads are transferred and processed at EPA-compliant regional landfills like ${loc.landfill_name}.`
                  : `All waste loads are transferred and processed at EPA-compliant regional landfills.`}
              </p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="bg-orange-50 text-[#f07c00] p-2 rounded-lg mt-0.5 text-xs font-bold shadow-sm">✓</div>
            <div>
              <h4 class="font-display font-bold text-slate-900 text-sm sm:text-base">Local Permit Guidance</h4>
              <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Receive clear municipal code advice if your container requires Right-of-Way street parking approvals.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Lead Capture Form Right Side -->
      <div class="lg:col-span-5 w-full flex justify-center lg:justify-end">
        <div class="w-full max-w-md">
          <LeadForm city={cityName} state={stateCode} startingPrice={popular20ydLow} />
        </div>
      </div>

    </div>
  </section>

  <!-- Pricing Cards Matrix -->
  <section id="pricing-section" class="min-h-[calc(100vh-73px)] flex flex-col justify-center py-12 px-6 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto space-y-16">

      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-slate-900 leading-tight">
          Typical Dumpster Costs in {cityName}
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          {pricingIntro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {pricingPlans.map(item => (
          <div class="glass-card-interactive rounded-2xl p-6 flex flex-col justify-between border-slate-200 hover:border-brand-500/30">
            <div class="space-y-4">

              <!-- Card Header -->
              <div class="flex items-center justify-between">
                <span class="font-display font-extrabold text-xl text-slate-900">{item.size}</span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-brand-500/10 text-brand-600 border border-brand-500/25">
                  {item.tons} Tons
                </span>
              </div>

              <!-- Estimated Price Range -->
              <div class="py-2">
                <span class="text-xs text-slate-400 block uppercase font-bold tracking-wider mb-0.5">Estimated Price Range</span>
                <span class="font-display font-black text-2xl sm:text-3xl text-slate-900">
                  ${item.low} - ${item.high}
                </span>
                <span class="text-xs text-slate-400 block mt-0.5">National estimate, not a quote</span>
              </div>

              <p class="text-xs text-slate-500 leading-relaxed min-h-[50px]">
                {item.desc}
              </p>

              <!-- Local Overage and Specs -->
              <div class="border-t border-slate-100 pt-4 space-y-2 text-xs text-slate-500">
                <div class="flex items-center justify-between">
                  <span>⚖️ <strong class="font-semibold text-slate-700">Weight Limit:</strong></span>
                  <span class="font-semibold text-slate-700">{item.tons} Tons Included</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>⚠️ <strong class="font-semibold text-slate-700">Overage Fee:</strong></span>
                  <span class="font-semibold text-brand-600">${item.overage}/Ton exceeding limit</span>
                </div>
              </div>
            </div>

            <button
              type="button"
              onclick="window.scrollTo({top: 0, behavior: 'smooth'}); document.getElementById('zip-code')?.focus();"
              class="block w-full text-center mt-6 py-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-display font-bold text-xs uppercase tracking-wider transition-all cursor-pointer shadow-md"
            >
              Check {item.size} Price
            </button>
          </div>
        ))}
      </div>

      <!-- Visual Anchor Bridging Banner -->
      <div class="mt-12 max-w-4xl mx-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden group">
        <div class="absolute inset-0 bg-brand-500/5 opacity-50 pointer-events-none"></div>
        <div class="flex items-center gap-4 relative z-10 text-left">
          <span class="text-3xl select-none animate-pulse">👉</span>
          <div>
            <h4 class="font-display font-extrabold text-white text-base">Get Your Exact Price</h4>
            <p class="text-xs text-slate-300 mt-0.5">
              Prices vary by project size and location. Enter your ZIP for a specific quote.
            </p>
          </div>
        </div>
        <button
          type="button"
          onclick="window.scrollTo({top: 0, behavior: 'smooth'}); setTimeout(() => { document.getElementById('zip-code')?.focus(); }, 400);"
          class="w-full md:w-auto px-6 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-display font-extrabold text-xs uppercase tracking-wider rounded-xl transition-all cursor-pointer shadow-[0_4px_15px_rgba(22,163,74,0.2)] group-hover:scale-[1.03]"
        >
          Check Local ZIP Code
        </button>
      </div>

    </div>
  </section>

  <!-- Social Proof & Trust Section -->
  <section class="min-h-[calc(100vh-73px)] flex flex-col justify-center py-12 px-6 border-y border-slate-200 bg-slate-50 relative overflow-hidden">
    <div class="ambient-glow-blue w-[300px] h-[300px] -top-20 left-1/2 animate-pulse-slow"></div>

    <div class="max-w-6xl mx-auto relative z-10 space-y-14">

      <!-- Aggregate Stats Bar -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-0 sm:divide-x divide-slate-200 text-center">
        <div class="space-y-1">
          <span class="font-display font-extrabold text-3xl sm:text-4xl text-slate-900">47,000+</span>
          <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400">🚛 Dumpsters Delivered Nationwide</span>
        </div>
        <div class="space-y-1">
          <span class="font-display font-extrabold text-3xl sm:text-4xl text-slate-900">4.8<span class="text-brand-600">/5</span></span>
          <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400">⭐ Average Customer Rating</span>
        </div>
        <div class="space-y-1">
          <span class="font-display font-extrabold text-3xl sm:text-4xl text-slate-900">10,000+</span>
          <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400">📍 U.S. Cities Served</span>
        </div>
      </div>

      <!-- Trust Badge Bar -->
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 pt-4">
        <div class="flex items-center gap-2 text-xs text-slate-400 font-semibold uppercase tracking-wider">
          <span class="text-base">🏅</span> BBB Accredited Partners
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-400 font-semibold uppercase tracking-wider">
          <span class="text-base">♻️</span> EPA Compliant Disposal
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-400 font-semibold uppercase tracking-wider">
          <span class="text-base">🛡️</span> Licensed & Insured Haulers
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-400 font-semibold uppercase tracking-wider">
          <span class="text-base">💳</span> All Major Cards Accepted
        </div>
      </div>

    </div>
  </section>

  {(hasPermitInfo || hasLandfill) && (
    <section class="min-h-[calc(100vh-73px)] flex flex-col justify-center py-12 px-6 max-w-5xl mx-auto space-y-16">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-stretch">

        {hasPermitInfo && (
          <div class={`glass-card rounded-3xl p-8 flex flex-col justify-between border-slate-200 ${hasLandfill ? 'md:col-span-7' : 'md:col-span-12'}`}>
            <div class="space-y-4">
              <div class="inline-block px-3 py-1 rounded bg-brand-500/10 border border-brand-500/25 text-brand-600 font-display font-bold text-xs uppercase tracking-wider">
                📋 Permit Compliance Guide
              </div>

              <h3 class="font-display font-extrabold text-2xl text-slate-900">
                Do I need a dumpster permit in {cityName}?
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed">
                If you place your roll-off container entirely on your private property (e.g. your driveway, yard, or loading dock), <strong>no permit is required</strong>.
              </p>

              {loc.permit_required === 1 ? (
                <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs leading-relaxed text-slate-700">
                  ⚠️ <strong>Street Placement Alert:</strong> {permitParagraph}
                </div>
              ) : (
                <div class="p-4 rounded-xl bg-green-50 border border-green-200 text-xs leading-relaxed text-slate-700">
                  ✓ <strong>Street Placement Rules:</strong> {permitParagraph}
                </div>
              )}
            </div>
          </div>
        )}

        {hasLandfill && (
          <div class={`glass-card rounded-3xl p-8 flex flex-col justify-between border-slate-200 relative overflow-hidden ${hasPermitInfo ? 'md:col-span-5' : 'md:col-span-12'}`}>
            <div class="space-y-4">
              <div class="inline-block px-3 py-1 rounded bg-blue-50/50 border border-blue-200 text-blue-600 font-display font-bold text-xs uppercase tracking-wider">
                ♻️ Landfill Direct
              </div>

              <h3 class="font-display font-extrabold text-2xl text-slate-900">
                Environmental Disposal
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed">
                {landfillParagraph}
              </p>

              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-center">
                <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Local Processing Hub</span>
                <span class="font-display font-extrabold text-sm text-slate-800">{loc.landfill_name}</span>
                <span class="block text-[10px] text-slate-500 mt-1">Servicing the Greater {cityName} Area</span>
              </div>
            </div>
          </div>
        )}

      </div>
    </section>
  )}

  <!-- Local Infrastructure & Rules Dashboard -->
  <section class="min-h-[calc(100vh-73px)] flex flex-col justify-center py-12 px-6 bg-slate-50 border-t border-slate-200 relative overflow-hidden">
    <!-- Ambient Glows -->
    <div class="ambient-glow-amber w-[300px] h-[300px] top-1/2 -right-10 animate-pulse-slow"></div>

    <div class="max-w-5xl mx-auto space-y-12 relative z-10">

      <!-- Section Header -->
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <div class="inline-block px-3 py-1 rounded bg-brand-500/10 border border-brand-500/25 text-brand-600 font-display font-bold text-xs uppercase tracking-wider">
          📊 Regional Specs & Material Rules
        </div>
        <h2 class="font-display font-extrabold text-3xl text-slate-900 leading-tight">
          Local Infrastructure & Compliance Directory
        </h2>
        <p class="text-slate-600 text-sm">
          Population data and material handling guidelines for the {cityName} area.
        </p>
      </div>

      <!-- Two Column Layout -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-stretch">

        <!-- Column 1: Local Stats Matrix -->
        <div class="md:col-span-6 glass-card rounded-3xl p-8 border-slate-200 flex flex-col justify-between">
          <div class="space-y-6">
            <h3 class="font-display font-extrabold text-xl text-slate-900 flex items-center gap-3">
              <span>📋</span> Regional Profile & Stats
            </h3>

            <div class="space-y-4">
              <!-- Population served -->
              <div class="flex items-center justify-between border-b border-slate-100 pb-3 text-sm">
                <span class="text-slate-500">👥 Estimated Population Served:</span>
                <span class="font-semibold text-slate-800 font-display">
                  {loc.population.toLocaleString()} Residents
                </span>
              </div>

              <!-- State Jurisdiction -->
              <div class="flex items-center justify-between border-b border-slate-100 pb-3 text-sm">
                <span class="text-slate-500">🏛️ State Jurisdiction:</span>
                <span class="font-semibold text-slate-800">
                  {stateFull} ({stateCode})
                </span>
              </div>

              {hasLandfill && (
                <div class="flex items-center justify-between border-b border-slate-100 pb-3 text-sm">
                  <span class="text-slate-500">♻️ Target Disposal Hub:</span>
                  <span class="font-semibold text-slate-800 truncate max-w-[200px]" title={loc.landfill_name}>
                    {loc.landfill_name}
                  </span>
                </div>
              )}

              {hasPermitInfo && (
                <div class="flex items-center justify-between text-sm">
                  <span class="text-slate-500">💰 Municipal Permit Fee:</span>
                  <span class="font-semibold text-slate-800">
                    {loc.permit_required === 1 ? `$${(loc.permit_cost as number).toFixed(2)} (Avg)` : 'No standard fee'}
                  </span>
                </div>
              )}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 text-[10px] text-slate-400 leading-relaxed">
            * Population figures are based on public data. Permit and landfill specifics are shown only where verified on file for this city.
          </div>
        </div>

        <!-- Column 2: Material Permissibility Matrix -->
        <div class="md:col-span-6 glass-card rounded-3xl p-8 border-slate-200 flex flex-col justify-between">
          <div class="space-y-6">
            <h3 class="font-display font-extrabold text-xl text-slate-900 flex items-center gap-3">
              <span>🚫</span> Material Compliance Matrix
            </h3>

            <p class="text-xs text-slate-500 leading-relaxed">
              Standard rules dictate what types of solid waste are allowed in roll-off containers. Banned items must be disposed of at specialized facilities.
            </p>

            <div class="grid grid-cols-2 gap-4 pt-2">

              <!-- Column: Allowed -->
              <div class="space-y-2.5">
                <span class="text-xs font-bold text-green-600 block uppercase tracking-wider mb-1">✓ Standard Allowed</span>
                <div class="flex items-center gap-2 text-xs text-slate-600">
                  <span class="text-green-500">✔</span> Household Junk
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-600">
                  <span class="text-green-500">✔</span> Wood & Drywall
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-600">
                  <span class="text-green-500">✔</span> Concrete & Dirt
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-600">
                  <span class="text-green-500">✔</span> Metal & Shingles
                </div>
              </div>

              <!-- Column: Prohibited -->
              <div class="space-y-2.5">
                <span class="text-xs font-bold text-red-600 block uppercase tracking-wider mb-1">✗ Banned / Prohibited</span>
                <div class="flex items-center gap-2 text-xs text-slate-600">
                  <span class="text-red-500">✘</span> Wet Paints
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-600">
                  <span class="text-red-500">✘</span> Car Batteries
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-600">
                  <span class="text-red-500">✘</span> Hazardous Oils
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-600">
                  <span class="text-red-500">✘</span> Propane Tanks
                </div>
              </div>

            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 text-[10px] text-slate-400 leading-relaxed">
            ⚠️ Loading hazardous or prohibited waste may trigger EPA compliance flags and local sorting penalty surcharges. Please contact us through the quote form to handle exceptional items.
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- Local FAQ Accordions -->
  <section class="min-h-[calc(100vh-73px)] flex flex-col justify-center py-12 px-6 bg-white border-t border-slate-200">
    <div class="max-w-3xl mx-auto space-y-12">

      <div class="text-center space-y-4">
        <h2 class="font-display font-extrabold text-3xl text-slate-900">
          Frequently Asked Questions in {cityName}
        </h2>
        <p class="text-slate-600 text-sm">Everything you need to know about renting a dumpster locally.</p>
      </div>

      <div class="space-y-4">
        {faqEntries.map(faq => (
          <div class="glass-card rounded-2xl p-6 space-y-3">
            <h4 class="font-display font-bold text-slate-900 text-base">
              {faq.q}
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>
