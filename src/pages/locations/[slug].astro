  <!-- Activity Ticker Rotation Script -->
  <script>
    function initActivityTicker() {
      const ticker = document.getElementById('activity-ticker');
      if (!ticker) return;

      const items = ticker.querySelectorAll('.activity-ticker-item');
      if (items.length <= 1) return;

      let currentIndex = 0;

      setInterval(() => {
        // Fade out current
        const current = items[currentIndex] as HTMLElement;
        current.classList.remove('opacity-100', 'translate-y-0');
        current.classList.add('opacity-0', '-translate-y-4');

        // Move to next
        currentIndex = (currentIndex + 1) % items.length;

        // Fade in next (with slight delay for smooth transition)
        setTimeout(() => {
          const next = items[currentIndex] as HTMLElement;
          next.classList.remove('opacity-0', 'translate-y-4', '-translate-y-4');
          next.classList.add('opacity-100', 'translate-y-0');
        }, 300);
      }, 4000);
    }

    initActivityTicker();
    document.addEventListener('astro:page-load', initActivityTicker);
  </script>
