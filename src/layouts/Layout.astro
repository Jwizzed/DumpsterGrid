---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  phone?: string;
  schema?: string;
}

const { 
  title, 
  description, 
  phone = "800-508-4000",
  schema
} = Astro.props;

// Canonical URL computation to guarantee search equity preservation
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Dynamic Canonical SEO Tag -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- JSON-LD Dynamic Schema Injection -->
    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body class="bg-dark-bg text-gray-100 min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-dark-bg pb-16 sm:pb-0">
    
    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 glass-card border-b border-dark-border py-4 px-6 md:px-12 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="bg-brand-500 text-dark-bg p-2 rounded-lg transition-transform duration-300 group-hover:rotate-12">
          <!-- Construction Dumpster SVG Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </div>
        <span class="font-display font-extrabold text-2xl tracking-tight bg-gradient-to-r from-white via-white to-brand-500 bg-clip-text text-transparent group-hover:text-glow-amber transition-all">
          Dumpster<span class="text-brand-500">Flow</span>
        </span>
      </a>
      
      <!-- Localized Quick CTA -->
      <div class="flex items-center gap-4">
        <a href={`tel:${phone}`} class="hidden sm:flex items-center gap-2.5 px-4 py-2 rounded-xl bg-brand-500 text-dark-bg font-display font-bold text-sm tracking-wide transition-all hover:bg-brand-600 active:scale-95 shadow-[0_4px_20px_rgba(245,158,11,0.2)]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call Local Dispatch
        </a>
        <a href={`tel:${phone}`} class="sm:hidden bg-brand-500 text-dark-bg p-2 rounded-xl active:scale-95">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </a>
      </div>
    </header>

    <!-- Main Dynamic Content Wrapper -->
    <main class="flex-grow relative z-10">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-dark-surface border-t border-dark-border py-12 px-6 md:px-12 text-gray-400 text-sm">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            <div class="bg-brand-500 text-dark-bg p-1.5 rounded-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </div>
            <span class="font-display font-extrabold text-lg text-white">
              Dumpster<span class="text-brand-500">Flow</span>
            </span>
          </div>
          <p class="max-w-md mb-4 text-gray-400">
            Connecting construction companies, commercial business managers, and residential property owners with premium, low-cost local dumpster rental haulers nationwide.
          </p>
          <div class="text-xs text-gray-500">
            © {new Date().getFullYear()} DumpsterFlow. All rights reserved. All listed haulers operate independently.
          </div>
        </div>

        <div>
          <h4 class="font-display font-semibold text-gray-500 mb-4 tracking-wide text-xs uppercase">Quick Links</h4>
          <ul class="space-y-2.5 text-xs">
            <li><a href="/" class="text-gray-500 hover:text-gray-300 transition-colors">Home Page</a></li>
            <li><a href="/locations" class="text-gray-500 hover:text-gray-300 transition-colors">Service Locations Directory</a></li>
            <li><a href="/locations/tx" class="text-gray-500 hover:text-gray-300 transition-colors">Texas Dumpster Rentals</a></li>
            <li><a href="/locations/ca" class="text-gray-500 hover:text-gray-300 transition-colors">California Dumpster Rentals</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-display font-semibold text-gray-500 mb-4 tracking-wide text-xs uppercase">Compliance & Legals</h4>
          <ul class="space-y-2.5 text-xs">
            <li><a href="/terms" class="text-gray-500 hover:text-gray-300 transition-colors">Terms of Service</a></li>
            <li><a href="/privacy" class="text-gray-500 hover:text-gray-300 transition-colors">Privacy Policy</a></li>
            <li><span class="text-gray-600 cursor-not-allowed">Do Not Sell My Info</span></li>
            <li><span class="text-gray-600 cursor-not-allowed">Partner Dispatcher Portal</span></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto pt-8 border-t border-gray-800 text-center text-xs text-gray-600">
        DumpsterFlow operates as a referral and informational resource network. All quote processing forms connect directly with independent waste disposal contractors. We do not personally haul waste or own/operate dumpsters.
      </div>
    </footer>

    <!-- Mobile Sticky Dual-Action Bottom Bar -->
    <div class="fixed bottom-0 left-0 right-0 z-50 flex sm:hidden border-t border-dark-border/40 shadow-[0_-5px_25px_rgba(0,0,0,0.5)]">
      <button 
        type="button" 
        onclick="const el = document.getElementById('zip-code') || document.getElementById('lead-capture-form'); if(el) { el.scrollIntoView({behavior: 'smooth'}); el.focus(); }"
        class="w-1/2 bg-white hover:bg-gray-100 text-dark-bg font-display font-extrabold text-xs uppercase tracking-wider py-4 text-center transition-colors cursor-pointer"
      >
        💬 Get Web Quote
      </button>
      <a 
        href={`tel:${phone}`} 
        class="w-1/2 bg-brand-500 hover:bg-brand-600 text-white font-display font-extrabold text-xs uppercase tracking-wider py-4 text-center transition-colors flex items-center justify-center gap-1.5 shadow-[0_-4px_15px_rgba(245,158,11,0.2)]"
      >
        📞 Call To Book
      </a>
    </div>
  </body>
</html>
