---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  phone?: string;
  schema?: string;
}

const { 
  title, 
  description, 
  phone = "800-508-4000",
  schema
} = Astro.props;

// Canonical URL computation to guarantee search equity preservation
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Dynamic Canonical SEO Tag -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- JSON-LD Dynamic Schema Injection -->
    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body class="bg-dark-bg text-slate-700 min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-white pb-16 sm:pb-0">
    
    <!-- Corporate Header Navigation (Hometown-Style Simple Single-Row) -->
    <header class="sticky top-0 z-50 w-full bg-white border-b border-slate-200 shadow-sm">
      <div class="max-w-7xl mx-auto py-3 px-6 md:px-12 flex items-center justify-between">
        
        <!-- Logo and Brand Info -->
        <a href="/" class="flex items-center group text-left">
          <div>
            <span class="block font-display font-black text-2xl tracking-tight text-slate-900 leading-tight">
              Dumpster<span class="text-[#f07c00]">Grid</span>
            </span>
            <span class="block text-[10px] sm:text-xs font-semibold text-slate-400 -mt-0.5 select-none">
              We've rented over 1 million dumpsters
            </span>
          </div>
        </a>

        <!-- Middle Simple Navigation Links -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600 select-none">
          <a href="/#sizing-chart" class="hover:text-brand-500 transition-colors">Dumpster Sizes</a>
          <a href="/locations" class="hover:text-brand-500 transition-colors">Prices</a>
          <a href="/locations" class="hover:text-brand-500 transition-colors">Locations</a>
        </nav>
        
        <!-- Action CTAs -->
        <div class="flex items-center gap-3">
          <!-- Check Your Price (Orange button modeled after BD) -->
          <button 
            type="button" 
            onclick="const el = document.getElementById('zip-code') || document.getElementById('quote-section'); if(el) { el.scrollIntoView({behavior: 'smooth'}); setTimeout(() => el.focus(), 600); } else { window.location.href = '/#quote-section'; }"
            class="hidden sm:flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#f07c00] hover:bg-[#d97000] text-white font-display font-extrabold text-xs sm:text-sm tracking-wide transition-all active:scale-95 shadow-md shadow-orange-500/10 cursor-pointer"
          >
            💬 Check Your Price
          </button>
          
          <a href={`tel:${phone}`} class="hidden sm:flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-display font-bold text-xs sm:text-sm tracking-wide transition-all active:scale-95 border border-slate-200 shadow-sm">
            📞 Call Dispatch
          </a>
          
          <a href={`tel:${phone}`} class="sm:hidden bg-[#f07c00] text-white p-2.5 rounded-xl active:scale-95 shadow-sm shadow-orange-500/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </a>
        </div>

      </div>
    </header>

    <!-- Main Dynamic Content Wrapper -->
    <main class="flex-grow relative z-10">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-12 px-6 md:px-12 text-slate-400 text-sm">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
        <div class="md:col-span-2">
          <div class="flex items-center mb-4">
            <span class="font-display font-extrabold text-lg text-white">
              Dumpster<span class="text-[#f07c00]">Grid</span>
            </span>
          </div>
          <p class="max-w-md mb-4 text-slate-400 leading-relaxed">
            Connecting construction companies, commercial business managers, and residential property owners with premium, low-cost local dumpster rental haulers nationwide.
          </p>
          <div class="text-xs text-slate-400">
            © {new Date().getFullYear()} DumpsterGrid. All rights reserved. All listed haulers operate independently.
          </div>
        </div>

        <div>
          <h4 class="font-display font-semibold text-slate-200 mb-4 tracking-wide text-xs uppercase">Quick Links</h4>
          <ul class="space-y-2.5 text-xs">
            <li><a href="/" class="text-slate-400 hover:text-white transition-colors">Home Page</a></li>
            <li><a href="/locations" class="text-slate-400 hover:text-white transition-colors">Service Locations Directory</a></li>
            <li><a href="/locations/tx" class="text-slate-400 hover:text-white transition-colors">Texas Dumpster Rentals</a></li>
            <li><a href="/locations/ca" class="text-slate-400 hover:text-white transition-colors">California Dumpster Rentals</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-display font-semibold text-slate-200 mb-4 tracking-wide text-xs uppercase">Compliance & Legals</h4>
          <ul class="space-y-2.5 text-xs">
            <li><a href="/terms" class="text-slate-400 hover:text-white transition-colors">Terms of Service</a></li>
            <li><a href="/privacy" class="text-slate-400 hover:text-white transition-colors">Privacy Policy</a></li>
            <li><span class="text-slate-600 cursor-not-allowed">Do Not Sell My Info</span></li>
            <li><span class="text-slate-600 cursor-not-allowed">Partner Dispatcher Portal</span></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto pt-8 border-t border-slate-800 text-center text-xs text-slate-400">
        DumpsterGrid operates as a referral and informational resource network. All quote processing forms connect directly with independent waste disposal contractors. We do not personally haul waste or own/operate dumpsters.
      </div>
    </footer>

    <!-- Mobile Sticky Dual-Action Bottom Bar -->
    <div class="fixed bottom-0 left-0 right-0 z-50 flex sm:hidden border-t border-slate-200 shadow-[0_-5px_25px_rgba(0,0,0,0.08)]">
      <button 
        type="button" 
        onclick="const el = document.getElementById('zip-code') || document.getElementById('lead-capture-form'); if(el) { el.scrollIntoView({behavior: 'smooth'}); el.focus(); }"
        class="w-1/2 bg-white hover:bg-slate-50 text-slate-900 font-display font-extrabold text-xs uppercase tracking-wider py-4 text-center transition-colors cursor-pointer"
      >
        💬 Get Web Quote
      </button>
      <a 
        href={`tel:${phone}`} 
        class="w-1/2 bg-brand-500 hover:bg-brand-600 text-white font-display font-extrabold text-xs uppercase tracking-wider py-4 text-center transition-colors flex items-center justify-center gap-1.5 shadow-[0_-4px_15px_rgba(15,89,193,0.15)]"
      >
        📞 Call To Book
      </a>
    </div>
  </body>
</html>
